<UserControl x:Class="FunkyLauncher.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource TitleFont}" FontSize="28"/>
            <TextBlock x:Name="Subtitle" FontSize="14" Foreground="#C9C9D6" Margin="0,4,0,0"/>
        </StackPanel>
        <UniformGrid x:Name="ToolCards" DockPanel.Dock="Top" Columns="5" Margin="0,0,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Padding="22,18" Margin="0,8,16,16">
                <Grid>
                <StackPanel x:Name="ShootPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ShootTitle" FontFamily="{StaticResource TitleFont}" FontSize="20"/>
                    <TextBlock x:Name="ShootStatus" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ShootIntro" FontSize="13" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShootIcons" Margin="0,14,0,0" Click="ShootOption_Click"/>
                    <CheckBox x:Name="ShootWallpaper" Margin="0,10,0,0" Click="ShootOption_Click"/>
                    <WrapPanel Margin="28,6,0,0">
                        <TextBlock x:Name="WallpaperText" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="WallpaperPick" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="0,0,8,0" Click="WallpaperPick_Click"/>
                        <Button x:Name="WallpaperBrand" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Click="WallpaperBrand_Click"/>
                    </WrapPanel>
                    <CheckBox x:Name="ShootWindows" Margin="0,10,0,0" Click="ShootOption_Click"/>
                    <CheckBox x:Name="ShootTaskbar" Margin="0,10,0,0" Click="ShootOption_Click"/>
                    <TextBlock x:Name="ShootWarn" FontSize="12.5" Foreground="{StaticResource Pink}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ShootButton" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Click="Shoot_Click"/>
                        <Button x:Name="DndButton" Style="{StaticResource SecondaryButton}" Height="42" Padding="18,0" Margin="0,0,12,8" Click="Dnd_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="DndHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ShootMessage" FontSize="13" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ProPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProTitle" FontFamily="{StaticResource TitleFont}" FontSize="20" Text="Funky Pro"/>
                    <TextBlock x:Name="ProInfo" FontSize="13" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,8,0,10"/>
                    <ContentControl x:Name="ProHost"/>
                </StackPanel>
                <StackPanel x:Name="DeskPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DeskTitle" FontFamily="{StaticResource TitleFont}" FontSize="20"/>
                    <TextBlock x:Name="DeskStatus" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="DeskIntro" FontSize="13" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,14,0,10">
                        <Button x:Name="DeskButton" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Click="Desk_Click"/>
                    </WrapPanel>
                    <Grid x:Name="DeskGrid" Margin="0,4,0,8"/>
                    <TextBlock x:Name="DeskPublic" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="DeskWallpaper" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="GamePanel" Visibility="Collapsed">
                    <TextBlock x:Name="GameTitle" FontFamily="{StaticResource TitleFont}" FontSize="20"/>
                    <TextBlock x:Name="GameStatus" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="GameIntro" FontSize="13" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <DockPanel Margin="0,14,0,6">
                        <Button x:Name="GameRefresh" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Click="GameRefresh_Click"/>
                        <TextBlock x:Name="GameAppsTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel x:Name="GameApps" Margin="0,0,0,4"/>
                    <CheckBox x:Name="GameTorrents" Margin="0,10,0,0" Click="GameOption_Click"/>
                    <CheckBox x:Name="GamePower" Margin="0,10,0,0" Click="GameOption_Click"/>
                    <TextBlock x:Name="GamePowerNa" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <CheckBox x:Name="GameOneDrive" Margin="0,10,0,0" Click="GameOption_Click"/>
                    <CheckBox x:Name="GameRelaunch" Margin="0,10,0,0" Click="GameOption_Click"/>
                    <CheckBox x:Name="GameOnPlay" Margin="0,10,0,0" Click="GameOption_Click"/>
                    <DockPanel x:Name="GameWinRow" Margin="0,12,0,0">
                        <Button x:Name="GameWinButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Click="GameWin_Click"/>
                        <TextBlock x:Name="GameWinText" FontSize="12.5" Foreground="{StaticResource Pink}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="GameButton" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Click="Game_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="GameMessage" FontSize="13" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="PcPanel" Visibility="Collapsed">
                    <TextBlock x:Name="PcTitle" FontFamily="{StaticResource TitleFont}" FontSize="20"/>
                    <WrapPanel x:Name="PcModlistRow" Margin="0,12,0,0"/>
                    <TextBlock x:Name="PcIntro" FontSize="13" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="PcButton" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Click="Pc_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="PcVerdict" FontFamily="{StaticResource TitleFont}" FontSize="24" Margin="0,10,0,0"/>
                    <TextBlock x:Name="PcVerdictText" FontSize="14" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <StackPanel x:Name="PcRows"/>
                </StackPanel>
                <StackPanel x:Name="BackupPanel">
                    <TextBlock x:Name="BackupTitle" FontFamily="{StaticResource TitleFont}" FontSize="20"/>
                    <WrapPanel x:Name="ModlistRow" Margin="0,12,0,0"/>
                    <TextBlock x:Name="SourceText" FontSize="13" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock x:Name="StoreText" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <CheckBox x:Name="AutoCheck" Margin="0,14,0,0" Click="Auto_Click"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="NowButton" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Click="Now_Click"/>
                        <Button x:Name="SavesButton" Style="{StaticResource SecondaryButton}" Height="42" Padding="18,0" Margin="0,0,12,8" Click="Saves_Click"/>
                        <Button x:Name="DirButton" Style="{StaticResource SecondaryButton}" Height="42" Padding="18,0" Margin="0,0,12,8" Click="Dir_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="Message" FontSize="13" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ListTitle" FontSize="15" FontWeight="Bold" Margin="0,18,0,10"/>
                    <StackPanel x:Name="ListPanel"/>
                </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
