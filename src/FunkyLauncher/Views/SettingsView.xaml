<UserControl x:Class="FunkyLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="40,32" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" FontFamily="{StaticResource TitleFont}" FontSize="30" Margin="0,0,0,24"/>

        <TextBlock x:Name="ModlistLabel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
        <DockPanel>
            <Button x:Name="ModlistBrowse" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ModlistBrowse_Click"/>
            <TextBox x:Name="ModlistBox" IsReadOnly="True"/>
        </DockPanel>

        <TextBlock x:Name="PrivacyLabel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,32,0,8"/>
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <CheckBox x:Name="NewsCheck" Click="Privacy_Changed"/>
                <CheckBox x:Name="CatalogCheck" Margin="0,10,0,0" Click="Privacy_Changed"/>
                <TextBlock x:Name="PrivacyText" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="PrivacyLink" FontSize="13" Foreground="{StaticResource Cyan}" Cursor="Hand" Margin="0,6,0,0" MouseLeftButtonUp="PrivacyLink_Click"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ProLabel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,32,0,8"/>
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="ProStatus" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ProText" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <DockPanel>
                    <Button x:Name="ProRemove" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ProRemove_Click"/>
                    <Button x:Name="ProActivate" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ProActivate_Click"/>
                    <TextBox x:Name="ProKeyBox" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
                <TextBlock x:Name="ProMessage" FontSize="12.5" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="AboutLabel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,32,0,8"/>
        <Border Style="{StaticResource CardBorder}">
            <TextBlock x:Name="AboutText" FontSize="14" LineHeight="21"/>
        </Border>
    </StackPanel>
</UserControl>
