<UserControl x:Class="FunkyLauncher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="40,32">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource TitleFont}" FontSize="30"/>
            <TextBlock x:Name="Subtitle" FontSize="15" Foreground="#C9C9D6" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Cards"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
