<UserControl x:Class="FunkyLauncher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource TitleFont}" FontSize="28"/>
            <TextBlock x:Name="Subtitle" FontSize="14" Foreground="#C9C9D6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Modlist cards -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,18">
            <StackPanel x:Name="Cards" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Selected modlist -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Banner" Grid.Column="0" CornerRadius="18" ClipToBounds="True" Background="#1D1D26">
                <Grid>
                    <Border CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F50F0F14" Offset="0"/>
                                <GradientStop Color="#B80F0F14" Offset="0.45"/>
                                <GradientStop Color="#100F0F14" Offset="0.85"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,30">
                        <Border HorizontalAlignment="Left" CornerRadius="12" Background="#243CE6FF" Padding="12,5">
                            <TextBlock x:Name="TagText" FontSize="13" FontWeight="SemiBold" Foreground="#9AF2FF"/>
                        </Border>
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource TitleFont}" FontSize="54" Margin="0,10,0,4"/>
                        <TextBlock x:Name="Description" FontSize="14" Foreground="#D6D6E2" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="Sub" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="MainButton" Style="{StaticResource PrimaryButton}" Click="MainButton_Click"/>
                            <Button x:Name="FolderButton" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="FolderButton_Click"/>
                            <Button x:Name="Mo2Button" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="Mo2Button_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PlayMessage" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16">
                <DockPanel>
                    <Button x:Name="SetupButton" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Height="42" Click="Setup_Click"/>
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel x:Name="StatusList"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
