<Window x:Class="FunkyLauncher.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Funky Launcher" Width="1280" Height="800" Icon="/Assets/launcher.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="←" Style="{StaticResource SecondaryButton}" Width="40" Height="36" Padding="0" Click="Back_Click"/>
                    <Button x:Name="ForwardButton" Content="→" Style="{StaticResource SecondaryButton}" Width="40" Height="36" Padding="0" Margin="6,0,0,0" Click="Forward_Click"/>
                    <Button Content="⟳" Style="{StaticResource SecondaryButton}" Width="40" Height="36" Padding="0" Margin="6,0,0,0" Click="Reload_Click"/>
                    <Button Content="⌂" Style="{StaticResource SecondaryButton}" Width="40" Height="36" Padding="0" Margin="6,0,10,0" Click="Home_Click"/>
                </StackPanel>
                <TextBox x:Name="Address" VerticalContentAlignment="Center" KeyDown="Address_KeyDown"/>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
