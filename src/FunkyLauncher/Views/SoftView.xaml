<UserControl x:Class="FunkyLauncher.Views.SoftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource TitleFont}" FontSize="28"/>
            <TextBlock x:Name="Subtitle" FontSize="14" Foreground="#C9C9D6" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="Items" Columns="3" VerticalAlignment="Top"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
