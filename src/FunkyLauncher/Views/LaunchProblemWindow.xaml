<Window x:Class="FunkyLauncher.Views.LaunchProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funky Launcher" Width="620" SizeToContent="Height" Icon="/Assets/launcher.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}">
    <Border Padding="32,28">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource TitleFont}" FontSize="26" Foreground="{StaticResource Pink}"/>
            <TextBlock x:Name="BodyText" FontSize="14" LineHeight="21" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock x:Name="HelpText" FontSize="13" LineHeight="20" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <TextBlock x:Name="CrashText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="RepairButton" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Click="Repair_Click"/>
            <Button x:Name="RollbackButton" Style="{StaticResource SecondaryButton}" Height="44" Margin="0,10,0,0" Click="Rollback_Click"/>
            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button x:Name="ReportButton" Style="{StaticResource SecondaryButton}" Height="44" Margin="0,0,5,0" Click="Report_Click"/>
                <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Height="44" Margin="5,0,0,0" Click="Close_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
