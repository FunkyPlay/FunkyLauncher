<UserControl x:Class="FunkyLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="335"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero: about the launcher -->
        <Border Grid.Row="0" CornerRadius="18" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/welcome.jpg" Stretch="UniformToFill" AlignmentY="Top"/>
            </Border.Background>
            <Grid>
                <Border CornerRadius="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F50F0F14" Offset="0"/>
                            <GradientStop Color="#C00F0F14" Offset="0.45"/>
                            <GradientStop Color="#200F0F14" Offset="0.85"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="36,0,36,0" MaxWidth="780" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/icon.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="StartTitle" FontFamily="{StaticResource TitleFont}" FontSize="42" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StartText" FontSize="14.5" LineHeight="21" Foreground="#D6D6E2" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border CornerRadius="10" Background="#C02A1426" BorderBrush="#66FF3CC8" BorderThickness="1" Padding="12,7" MaxWidth="380">
                            <TextBlock x:Name="PremiumText" FontSize="12.5" Foreground="#FFC6EE" TextWrapping="Wrap"/>
                        </Border>
                        <Border CornerRadius="10" Background="#C00F2A33" BorderBrush="#663CE6FF" BorderThickness="1" Padding="12,7" Margin="10,0,0,0" MaxWidth="380">
                            <TextBlock x:Name="FreeText" FontSize="12.5" Foreground="#C6F7FF" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="LibraryButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Library_Click"/>
                </StackPanel>

                <!-- corners of the picture -->
                <Button Content="GitHub" Style="{StaticResource SecondaryButton}" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" Click="GitHub_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
                    <Button Content="Telegram" Style="{StaticResource SecondaryButton}" Height="44" Click="Telegram_Click"/>
                    <Button Content="YouTube" Style="{StaticResource SecondaryButton}" Height="44" Margin="10,0,0,0" Click="YouTube_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- News | What's new + Support -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="AllNews" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource Cyan}" Cursor="Hand" MouseLeftButtonUp="AllNews_Click"/>
                    <TextBlock x:Name="NewsTitle" FontSize="18" FontWeight="Bold"/>
                </DockPanel>
                <UniformGrid x:Name="NewsGrid" Columns="3" VerticalAlignment="Top"/>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource CardBorder}" Padding="18,12">
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewTitle" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="WhatsNewText" FontSize="12.5" LineHeight="19" Foreground="#C9C9D6" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SupportTitle" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SupportText" FontSize="12.5" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="SupportButton" Style="{StaticResource SecondaryButton}" Height="38" Click="Support_Click"/>
                        <Button x:Name="ReportButton" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,8,0,0" Click="Report_Click"/>
                        <TextBlock x:Name="ReportText" FontSize="12" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
