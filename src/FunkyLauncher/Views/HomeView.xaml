<UserControl x:Class="FunkyLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" CornerRadius="18" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/banner.jpg" Stretch="UniformToFill" AlignmentY="Center"/>
            </Border.Background>
            <Grid>
                <Border CornerRadius="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F50F0F14" Offset="0"/>
                            <GradientStop Color="#B80F0F14" Offset="0.4"/>
                            <GradientStop Color="#100F0F14" Offset="0.78"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,36">
                    <Border HorizontalAlignment="Left" CornerRadius="12" Background="#243CE6FF" Padding="12,5">
                        <TextBlock x:Name="TagText" FontSize="13" FontWeight="SemiBold" Foreground="#9AF2FF"/>
                    </Border>
                    <TextBlock Text="NEON NIGHTS" FontFamily="{StaticResource TitleFont}" FontSize="62" Margin="0,10,0,4"/>
                    <TextBlock x:Name="Sub" FontSize="15" Foreground="#C9C9D6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="MainButton" Style="{StaticResource PrimaryButton}" Click="MainButton_Click"/>
                        <Button x:Name="FolderButton" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="FolderButton_Click"/>
                        <Button x:Name="Mo2Button" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="Mo2Button_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PlayMessage" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- News + status -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="AllNews" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource Cyan}" Cursor="Hand" MouseLeftButtonUp="AllNews_Click"/>
                    <TextBlock x:Name="NewsTitle" FontSize="18" FontWeight="Bold"/>
                </DockPanel>
                <UniformGrid x:Name="NewsGrid" Columns="3"/>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16">
                <DockPanel>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2">
                        <Button Content="Telegram" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,4,0" Click="Telegram_Click"/>
                        <Button Content="YouTube" Style="{StaticResource SecondaryButton}" Height="38" Margin="4,0,0,0" Click="YouTube_Click"/>
                    </UniformGrid>
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel x:Name="StatusList"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
