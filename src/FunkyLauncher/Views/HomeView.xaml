<UserControl x:Class="FunkyLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero: about the launcher -->
        <Border Grid.Row="0" CornerRadius="18" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/welcome.jpg" Stretch="UniformToFill" AlignmentY="Top"/>
            </Border.Background>
            <Grid>
                <Border CornerRadius="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F50F0F14" Offset="0"/>
                            <GradientStop Color="#C00F0F14" Offset="0.45"/>
                            <GradientStop Color="#200F0F14" Offset="0.85"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="40,0,40,0" MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/icon.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="StartTitle" FontFamily="{StaticResource TitleFont}" FontSize="46" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StartText" FontSize="15" LineHeight="22" Foreground="#D6D6E2" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="LibraryButton" Style="{StaticResource PrimaryButton}" Click="Library_Click"/>
                        <Button Content="Telegram" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="Telegram_Click"/>
                        <Button Content="YouTube" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="YouTube_Click"/>
                        <Button Content="GitHub" Style="{StaticResource SecondaryButton}" Height="54" Margin="12,0,0,0" Click="GitHub_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- News | What's new + Support -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="AllNews" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource Cyan}" Cursor="Hand" MouseLeftButtonUp="AllNews_Click"/>
                    <TextBlock x:Name="NewsTitle" FontSize="18" FontWeight="Bold"/>
                </DockPanel>
                <UniformGrid x:Name="NewsGrid" Columns="3" VerticalAlignment="Top"/>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Padding="18,14">
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewTitle" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="WhatsNewText" FontSize="12.5" LineHeight="19" Foreground="#C9C9D6" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SupportTitle" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SupportText" FontSize="12.5" Foreground="#C9C9D6" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="SupportButton" Style="{StaticResource SecondaryButton}" Height="38" Click="Support_Click"/>
                        <Button x:Name="ReportButton" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,8,0,0" Click="Report_Click"/>
                        <TextBlock x:Name="ReportText" FontSize="12" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
