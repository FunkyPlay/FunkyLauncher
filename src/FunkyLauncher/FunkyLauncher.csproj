<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- only for the tray icon (NotifyIcon) of Funky Desktops; its namespaces are not imported globally -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FunkyLauncher</AssemblyName>
    <RootNamespace>FunkyLauncher</RootNamespace>
    <Version>0.1.7</Version>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <Product>Funky Launcher</Product>
    <Company>FunkyPlay</Company>
    <Authors>Funky</Authors>
    <Copyright>Copyright (C) 2026 Funky. GPL-3.0-or-later.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\banner.jpg" />
    <Resource Include="Assets\launcher.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\welcome.jpg" />
    <Resource Include="Assets\home_bg.jpg" />
    <Resource Include="Assets\wallpaper.jpg" />
    <!-- catalog2.json since 0.1.7 (Neon Nights 0.1.1 needs the language packs); catalog.json stays for older launchers -->
    <Resource Include="..\..\catalog2.json" Link="catalog.json" />
    <Resource Include="..\..\addons\*.json" Link="addons\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
